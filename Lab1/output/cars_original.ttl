@prefix cars: <http://example.org/cars/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cars:BodyType a rdfs:Class ;
    rdfs:label "Тип кузова"@uk .

cars:Car a rdfs:Class ;
    rdfs:label "Автомобіль"@uk .

cars:Continent a rdfs:Class ;
    rdfs:label "Частина світу"@uk .

cars:Country a rdfs:Class ;
    rdfs:label "Країна"@uk .

cars:EngineType a rdfs:Class ;
    rdfs:label "Тип двигуна"@uk .

cars:Manufacturer a rdfs:Class ;
    rdfs:label "Виробник"@uk .

cars:BMW3Series a cars:Car ;
    cars:hasBodyType cars:Sedan ;
    cars:hasEngineType cars:Diesel ;
    cars:manufacturedBy cars:BMW ;
    schema:name "BMW 3 Series" ;
    schema:productionDate "2013"^^xsd:gYear .

cars:FordMustang a cars:Car ;
    cars:hasBodyType cars:Coupe ;
    cars:hasEngineType cars:Petrol ;
    cars:manufacturedBy cars:Ford ;
    schema:name "Ford Mustang" ;
    schema:productionDate "2014"^^xsd:gYear .

cars:HondaCivic a cars:Car ;
    cars:hasBodyType cars:Sedan ;
    cars:hasEngineType cars:Petrol ;
    cars:manufacturedBy cars:Honda ;
    schema:name "Honda Civic" ;
    schema:productionDate "2012"^^xsd:gYear .

cars:InfinitiQX70 a cars:Car ;
