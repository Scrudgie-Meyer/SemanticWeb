    cars:hasEngineType cars:Petrol ;
    cars:manufacturedBy cars:Renault ;
    schema:name "Renault Clio" ;
    schema:productionDate "2012"^^xsd:gYear .

cars:TeslaModelS a cars:Car ;
    cars:hasBodyType cars:Liftback ;
    cars:hasEngineType cars:Electric ;
    cars:manufacturedBy cars:Tesla ;
    schema:name "Tesla Model S" ;
    schema:productionDate "2014"^^xsd:gYear .

cars:ToyotaCorolla a cars:Car ;
    cars:hasBodyType cars:Sedan ;
    cars:hasEngineType cars:Petrol ;
    cars:manufacturedBy cars:Toyota ;
    schema:name "Toyota Corolla" ;
    schema:productionDate "2013"^^xsd:gYear .

cars:ToyotaRAV4 a cars:Car ;
    cars:hasBodyType cars:SUV ;
    cars:hasEngineType cars:Petrol ;
    cars:manufacturedBy cars:Toyota ;
    schema:name "Toyota RAV4" ;
    schema:productionDate "2014"^^xsd:gYear .

cars:VolkswagenGolf a cars:Car ;
    cars:hasBodyType cars:Hatchback ;
    cars:hasEngineType cars:Diesel ;
    cars:manufacturedBy cars:Volkswagen ;
    schema:name "Volkswagen Golf" ;
    schema:productionDate "2013"^^xsd:gYear .

cars:countryOfOrigin a rdf:Property ;
    rdfs:label "країна походження"@uk ;
    rdfs:domain cars:Manufacturer ;
    rdfs:range cars:Country .

cars:hasBodyType a rdf:Property ;
    rdfs:label "має тип кузова"@uk ;
    rdfs:domain cars:Car ;
    rdfs:range cars:BodyType .

cars:hasEngineType a rdf:Property ;
    rdfs:label "має тип двигуна"@uk ;
    rdfs:domain cars:Car ;
    rdfs:range cars:EngineType .

cars:locatedIn a rdf:Property ;
    rdfs:label "розташована у"@uk ;
    rdfs:domain cars:Country ;
    rdfs:range cars:Continent .

cars:manufacturedBy a rdf:Property ;
    rdfs:label "виготовлений виробником"@uk ;
    rdfs:domain cars:Car ;
    rdfs:range cars:Manufacturer .

cars:Asia a cars:Continent ;
