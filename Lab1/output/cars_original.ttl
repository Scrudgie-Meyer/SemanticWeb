    cars:hasEngineType cars:Petrol ;
    cars:manufacturedBy cars:Nissan ;
    schema:name "Nissan Qashqai" ;
    schema:productionDate "2014"^^xsd:gYear .

cars:RenaultClio a cars:Car ;
