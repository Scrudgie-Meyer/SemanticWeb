PREFIX cars: <http://example.org/cars/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?name ?year WHERE {
  ?car a cars:Car ; schema:name ?name ; schema:productionDate ?year .
  BIND(xsd:integer(STR(?year)) AS ?yearNumber)
  FILTER(?yearNumber > 2012 && ?yearNumber < 2015)
} ORDER BY DESC(?yearNumber) ?name
